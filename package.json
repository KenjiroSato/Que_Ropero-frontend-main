{
  "name": "que-ropero",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node api/index.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:frontend": "ng serve",
    "start:api": "node --watch api/index.js",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:api": "node --test api/tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write src api scripts tests *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check src api scripts tests *.json *.md .github/workflows/*.yml",
    "db:migrate": "node scripts/migrate.js",
    "admin:create": "node scripts/create-admin.js",
    "preview:demo": "node tests/fixture-server.js",
    "admin:reset-password": "node scripts/reset-password.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mssql": "^12.7.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2"
  },
  "description": "Alquiler de lavadoras a domicilio en Itagüí. Angular, Express y Azure SQL.",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "glob@>=8": "^14.0.2",
    "minimatch@>=4": "^11.0.1"
  }
}

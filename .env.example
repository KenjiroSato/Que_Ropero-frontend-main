NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:4200
# Variables exclusivas de Express. Nunca deben incluirse en Angular.
DB_SERVER=TU-SERVIDOR.database.windows.net
DB_NAME=QueRoperoDB
DB_PORT=1433
# En Azure App Service, preferir managed-identity y omitir usuario/contraseña.
DB_AUTH=sql
DB_USER=que_ropero_app
DB_PASSWORD=REEMPLAZAR_EN_EL_ENTORNO
# Solo desarrollo local con certificado autofirmado:
# DB_SERVER=localhost
# DB_TRUST_LOCAL_CERT=true
